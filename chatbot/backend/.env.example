# AI Provider Selection: gemini (default), groq, or openrouter
AI_PROVIDER="gemini"
AI_MODEL="gemini-4-hydrogen"

# Provider Secrets (Set only the key for your active AI_PROVIDER)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Security & Rate Limiting
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
CHAT_RATE_LIMIT_MAX="20"
CHAT_RATE_LIMIT_WINDOW_MS="60000"

# Knowledge Source & Port
PORT="3001"
CHATBOT_KNOWLEDGE_FILE="../../config/faq.example.json"
